@model NorthwindMvc.Models.CategoryDetailsViewModel

@{
    ViewData["Title"] = $"Category {Model.CategoryName}";
}

<div class="d-flex align-items-end justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <p class="eyebrow mb-2">Northwind data</p>
        <h1 class="h2 mb-0">Category info</h1>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to list</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <div class="row g-4 align-items-start">
            <div class="col-lg-8">
                <dl class="row mb-0 detail-grid">
                    <dt class="col-sm-3">Category ID</dt>
                    <dd class="col-sm-9">@Model.CategoryID</dd>

                    <dt class="col-sm-3">Category Name</dt>
                    <dd class="col-sm-9 fw-semibold">@Model.CategoryName</dd>

                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@(Model.Description ?? "—")</dd>
                </dl>
            </div>
            <div class="col-lg-4">
                @if (Model.PictureDataUrl is not null)
                {
                    <div class="category-image-frame">
                        <img src="@Model.PictureDataUrl" alt="@Model.CategoryName" class="img-fluid rounded-3 shadow-sm" />
                    </div>
                }
                else
                {
                    <div class="text-muted fst-italic">No picture available.</div>
                }
            </div>
        </div>
    </div>
</div>