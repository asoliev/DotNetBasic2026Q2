@model NorthwindMvc.Models.ProductDetailsViewModel

@{
    ViewData["Title"] = $"Product {Model.ProductName}";
}

<div class="d-flex align-items-end justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <p class="eyebrow mb-2">Northwind data</p>
        <h1 class="h2 mb-0">Product info</h1>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to list</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <tbody>
                    <tr>
                        <th scope="row" class="col-sm-3">Product ID</th>
                        <td>@Model.ProductID</td>
                    </tr>
                    <tr>
                        <th scope="row" class="col-sm-3">Product Name</th>
                        <td>@Model.ProductName</td>
                    </tr>
                    <tr>
                        <th scope="row" class="col-sm-3">Supplier</th>
                        <td>@(Model.SupplierName ?? "—")</td>
                    </tr>
                    <tr>
                        <th scope="row" class="col-sm-3">Category</th>
                        <td>@(Model.CategoryName ?? "—")</td>
                    </tr>
                    <tr>
                        <th scope="row" class="col-sm-3">Quantity Per Unit</th>
                        <td>@(Model.QuantityPerUnit ?? "—")</td>
                    </tr>
                    <tr>
                        <th scope="row" class="col-sm-3">Unit Price</th>
                        <td>@(Model.UnitPrice?.ToString("0.##") ?? "—")</td>
                    </tr>
                    <tr>
                        <th scope="row" class="col-sm-3">Units In Stock</th>
                        <td>@(Model.UnitsInStock?.ToString() ?? "—")</td>
                    </tr>
                    <tr>
                        <th scope="row" class="col-sm-3">Units On Order</th>
                        <td>@(Model.UnitsOnOrder?.ToString() ?? "—")</td>
                    </tr>
                    <tr>
                        <th scope="row" class="col-sm-3">Reorder Level</th>
                        <td>@(Model.ReorderLevel?.ToString() ?? "—")</td>
                    </tr>
                    <tr>
                        <th scope="row" class="col-sm-3">Discontinued</th>
                        <td>@(Model.Discontinued ? "Yes" : "No")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
